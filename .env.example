# Copy to .env for local development. Never commit .env.
ENV=dev
BASE_URL=http://localhost:8000
# App role (non-superuser; subject to row-level security)
DATABASE_URL=host=/tmp port=5433 dbname=crm user=crm_app password=crm_app
# Admin/owner role used only by `python -m app.migrate`
MIGRATE_DATABASE_URL=host=/tmp port=5433 dbname=crm user=crm
SECRET_KEY=change-me-to-32-plus-random-characters
COOKIE_SECURE=false
GOOGLE_MAPS_API_KEY=
CRON_SECRET=local-cron-secret

# --- Optional integrations (leave blank locally; the app logs what it would have sent) ---
SMS_PROVIDER=log            # twilio | fake | log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_AGENCY_FROM=         # +14165550100
EMAIL_PROVIDER=log          # smtp | postmark | sendgrid | fake | log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                  # the Workspace mailbox; defaults to EMAIL_FROM
SMTP_PASSWORD=              # a Google app password (2-Step Verification must be on for that account)
POSTMARK_TOKEN=
SENDGRID_API_KEY=
EMAIL_FROM=leads@web-marketing-toronto.com
CALLRAIL_SIGNING_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
ADS_PROVIDER=log            # live | fake | log
GOOGLE_ADS_YAML=            # path to google-ads.yaml (or set the five GOOGLE_ADS_* values)
